{{> header}}
<section id="settings" class="section-container">
  <div class="settings-hero">
    <p class="eyebrow">Account</p>
    <h1 class="settings-welcome">
      Settings
    </h1>
    <p>Manage domains, API access, and account security for <span>{{user.email}}</span>.</p>
  </div>
  {{> settings/domain/index}}
  {{> settings/apikey}}
  {{> settings/change_password}}
  {{#if mail_enabled}}
    {{> settings/change_email}}
  {{/if}}
  {{> settings/delete_account}}
</section>
{{> footer}}
