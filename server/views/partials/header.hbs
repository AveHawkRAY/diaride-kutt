<header>
  <div class="logo-wrapper">
    <a class="logo nav" href="/" title="DIA Ride Links">
      <span class="logo-mark">
        <img src="/images/logo.png" alt="DIA Ride" width="28" height="28" />
      </span>
      <span>DIA Ride Links</span>
    </a>
  </div>

  <nav>
    <ul>
      {{#unless user}}
        <li>
          <a class="button primary" href="/login" title="Log in">
            Log in
          </a>
        </li>
      {{/unless}}

      {{#if user}}
        <li>
          <a class="nav" href="/" title="Dashboard">
            Dashboard
          </a>
        </li>

        <li>
          <a class="nav" href="/settings" title="Settings">
            Settings
          </a>
        </li>

        {{#if isAdmin}}
          <li>
            <a class="nav" href="/admin" title="Admin">
              Admin
            </a>
          </li>
        {{/if}}

        <li>
          <a class="nav" href="/logout" title="Log out">
            Log out
          </a>
        </li>
      {{/if}}
    </ul>
  </nav>
</header>
